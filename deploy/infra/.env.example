# /opt/infra/.env —— 复制为 .env 并填入强随机密码
# 生成强密码示例：openssl rand -base64 24

# MySQL root 密码（必须修改）
MYSQL_ROOT_PASSWORD=please-change-me

# Redis 密码（requirepass，必须修改）
REDIS_PASSWORD=please-change-me

# Qdrant API Key（应用连 qdrant:6333 时需带上，必须修改）
QDRANT_API_KEY=please-change-me

# 时区（可选）
TZ=Asia/Shanghai

# ---------------------------------------------------------------------------
# 以下两项仅本地开发生效（docker-compose.local.yml + mysql/initdb.d/），
# 服务器版 docker-compose.yml 不读取，留空即用默认值。
# ---------------------------------------------------------------------------
# 本地通用开发账号：有全库权限，只建账号不建库，各项目的库自己创建
MYSQL_DEV_USERNAME=dev
MYSQL_DEV_PASSWORD=dev123456